# Fonction serverless netlify/functions/contact.js — à définir dans Netlify (Site
# configuration > Environment variables), jamais commitées dans le repo.
#
# Transport : Gmail (SMTP_USER = compte Gmail perso, avec un mot de passe
# d'application — https://myaccount.google.com/apppasswords, pas le mot de passe
# du compte). L'adresse "pro" contact@marc-dev.fr affichée sur le site (liens
# mailto:, mentions légales) n'a pas besoin de mailbox : elle n'intervient pas
# dans cet envoi, qui reste invisible pour le visiteur.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=
CONTACT_TO=votre-adresse@gmail.com
